# Copy to .env and fill in. .env is gitignored and never committed.

# --- Postgres (matches docker-compose.yml) ---
POSTGRES_USER=survey
POSTGRES_PASSWORD=survey_local_dev
POSTGRES_DB=survey
POSTGRES_HOST=localhost
POSTGRES_PORT=5433
DATABASE_URL=postgresql://survey:survey_local_dev@localhost:5433/survey

# --- Generator (config-swappable, never hardcoded — spec §4) ---
# Which provider/model the generator uses. Set in Phase 2.
GENERATOR_PROVIDER=anthropic
GENERATOR_MODEL=claude-sonnet-5
ANTHROPIC_API_KEY=

# --- Experiment tracking ---
MLFLOW_TRACKING_URI=sqlite:///mlflow.db

# --- Corpus ---
# Active corpus name. Each corpus gets its own index, schema, adapter, eval set.
CORPUS=semcom
